# Production template. The installer generates passwords; never commit a real .env.
XARIONIX_INSTALL_LANGUAGE=ru
XARIONIX_ENVIRONMENT=production
XARIONIX_KEYCLOAK_MODE=managed
XARIONIX_PUBLIC_URL=https://core.example.com
XARIONIX_KEYCLOAK_PUBLIC_URL=https://auth.example.com
XARIONIX_OIDC_ISSUER=https://auth.example.com/realms/xarionix
XARIONIX_OIDC_BACKCHANNEL=http://keycloak:8080/realms/xarionix
XARIONIX_OIDC_AUDIENCE=xarionix-core
XARIONIX_BROWSER_REDIRECT_URI=https://console.example.com/auth/callback
XARIONIX_BROWSER_ORIGIN=https://console.example.com
XARIONIX_DOCS_ENABLED=false
XARIONIX_CORS_ORIGINS=[]
XARIONIX_DB_PASSWORD=
XARIONIX_DB_BOOTSTRAP_PASSWORD=
XARIONIX_KC_DB_PASSWORD=
XARIONIX_KC_DB_BOOTSTRAP_PASSWORD=
XARIONIX_KC_ADMIN_PASSWORD=
XARIONIX_CORE_TLS_CERT=/absolute/path/core-fullchain.pem
XARIONIX_CORE_TLS_KEY=/absolute/path/core-private-key.pem
XARIONIX_KEYCLOAK_TLS_CERT=/absolute/path/auth-fullchain.pem
XARIONIX_KEYCLOAK_TLS_KEY=/absolute/path/auth-private-key.pem
XARIONIX_NGINX_UID=101
# Registry-verified immutable references; update tag and digest together:
XARIONIX_POSTGRES_IMAGE=postgres:18.6-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
XARIONIX_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332
XARIONIX_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
